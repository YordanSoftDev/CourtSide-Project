@model IEnumerable<CourtSide.ViewModels.Players.PlayerInfoViewModel>

@{
    var currentCategory = Context.Request.Query["category"].ToString();
    if (string.IsNullOrEmpty(currentCategory))
    {
        currentCategory = "ATP";
    }

    var isWta = currentCategory.Equals("WTA", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isWta ? "WTA singles rankings" : "ATP singles rankings";

    // Grab Top 3 Players dynamically from the model
    var top3Players = Model?.Where(p => p.Rank >= 1 && p.Rank <= 3)
                            .OrderBy(p => p.Rank)
                            .ToList() ?? new List<CourtSide.ViewModels.Players.PlayerInfoViewModel>();
}

<div class="w-100 min-vh-100 py-4" style="background-color: #F5F6F2;">
    <div class="container">

        <!-- 1. TOP HEADER SECTION -->
        <div class="mb-4">
            <h1 class="fw-bold display-5 mb-1" style="color: #142D25; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;">
                Rankings
            </h1>
            <p class="text-muted mb-0" style="font-size: 1.05rem;">
                The names setting the pace. Follow the climb across both tours.
            </p>
        </div>

        <!-- 2. CATEGORY SELECTOR BUTTONS ROW -->
        <div class="d-flex justify-content-center mb-4">
            <div class="row g-1 p-1 rounded-4 w-100" style="max-width: 380px; background-color: #EAF0E9;">
                <!-- ATP Button -->
                <div class="col-6">
                    <a asp-action="Index" asp-route-category="ATP"
                       class="btn w-100 py-1 fw-bold rounded-4 text-decoration-none text-center @(!isWta ? "shadow-sm" : "")"
                       style="background-color: @(!isWta ? "#123F30" : "transparent"); color: @(!isWta ? "#ffffff" : "#718078"); font-size: 0.95rem; border: none;">
                        ATP singles
                    </a>
                </div>
                <!-- WTA Button -->
                <div class="col-6">
                    <a asp-action="Index" asp-route-category="WTA"
                       class="btn w-100 py-1 fw-bold rounded-4 text-decoration-none text-center @(isWta ? "shadow-sm" : "")"
                       style="background-color: @(isWta ? "#123F30" : "transparent"); color: @(isWta ? "#ffffff" : "#718078"); font-size: 0.95rem; border: none;">
                        WTA singles
                    </a>
                </div>
            </div>
        </div>

        <!-- 3. TOP 3 TOUR LEADERS ROW -->
        @if (top3Players.Any())
        {
            <div class="row g-3 mb-4">
                @foreach (var player in top3Players)
                {
                    var isNumberOne = player.Rank == 1;

                    <div class="col-12 col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden"
                             style="background-color: @(isNumberOne ? "#123F30" : "#FFFFFF"); color: @(isNumberOne ? "#ffffff" : "#142D25"); font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;">
                            <div class="card-body p-3">

                                <!-- Header Row: Rank Badge & Label -->
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge px-2.5 py-1 fw-bold rounded-2"
                                          style="background-color: @(isNumberOne ? "#D5EF68" : "#EAF0E9"); color: #123F30; font-size: 0.75rem; letter-spacing: 0.5px;">
                                        NO. @player.Rank
                                    </span>

                                    <!-- THINNER TOUR LEADER / IN THE CHASE LABELS -->
                                    <span class="text-uppercase fw-normal"
                                          style="color: @(isNumberOne ? "rgba(255, 255, 255, 0.65)" : "#5C6E66"); font-size: 0.65rem; letter-spacing: 1.2px; font-weight: 400;">
                                        @(isNumberOne ? "TOUR LEADER" : "IN THE CHASE")
                                    </span>
                                </div>

                                <!-- Content Row: Name & Points Side-by-Side -->
                                <div class="row align-items-center g-2">
                                    <!-- Left: Name & Details -->
                                    <div class="col-7">
                                        <h3 class="fw-bold fs-5 mb-0 text-truncate" style="color: @(isNumberOne ? "#ffffff" : "#142D25"); letter-spacing: -0.3px;">
                                            @player.FullName
                                        </h3>
                                        <p class="mb-0 small text-truncate" style="color: @(isNumberOne ? "rgba(255, 255, 255, 0.7)" : "#718078"); font-size: 0.75rem;">
                                            @(string.IsNullOrEmpty(player.CountryName) ? "" : player.CountryName)
                                            @if (player.TournamentsPlayed.HasValue)
                                            {
                                                <span> &bull; @player.TournamentsPlayed.Value tournaments</span>
                                            }
                                        </p>
                                    </div>

                                    <!-- Right: Points -->
                                    <div class="col-5 text-end">
                                        <div class="fw-bold fs-4" style="color: @(isNumberOne ? "#D5EF68" : "#142D25"); line-height: 1;">
                                            @(player.Points.HasValue ? player.Points.Value.ToString("N0") : "0")
                                        </div>
                                        <div class="text-uppercase fw-semibold" style="color: @(isNumberOne ? "rgba(255, 255, 255, 0.6)" : "#718078"); font-size: 0.65rem; letter-spacing: 0.8px;">
                                            POINTS
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="mb-3">
            <h2 class="fw-bold mb-1" style="color: #0D3025; font-size: 1.6rem;">@ViewData["Title"]</h2>
            <p class="text-muted mb-0 small">
                20 October 2026 &bull; <span class="fw-normal" style="color: #718078;">Weekly standings</span>
            </p>
        </div>

        <!-- 5. RANKINGS TABLE CONTAINER -->
        <div class="table-responsive shadow-sm rounded-3">
            <table class="table align-middle mb-0" style="background-color: #ffffff;">
                <thead>
                    <tr>
                        <th scope="col" class="py-3 px-3 text-center" style="width: 80px; background-color: #EAF0E9 !important; color: #142D25 !important;">Rank</th>
                        <th scope="col" class="py-3 px-3" style="background-color: #EAF0E9 !important; color: #142D25 !important;">Player</th>
                        <th scope="col" class="py-3 px-3" style="background-color: #EAF0E9 !important; color: #142D25 !important;">Country</th>
                        <th scope="col" class="py-3 px-3 text-center" style="background-color: #EAF0E9 !important; color: #142D25 !important;">Points</th>
                        <th scope="col" class="py-3 px-3 text-center" style="background-color: #EAF0E9 !important; color: #142D25 !important;">Tournaments</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var player in Model)
                    {
                        <tr style="border-bottom: 1px solid rgba(113, 128, 120, 0.2);">
                            <!-- Rank -->
                            <td class="text-center fw-bold" style="color: #142D25; background-color: #ffffff">
                                @player.Rank
                            </td>

                            <!-- Player Name -->
                            <td class="fw-semibold px-3" style="color: #212529;">
                                @player.FullName
                            </td>

                            <!-- Country Name -->
                            <td class="px-3" style="color: #718078;">
                                @(string.IsNullOrEmpty(player.CountryName) ? "-" : player.CountryName)
                            </td>

                            <!-- Points -->
                            <td class="text-center fw-medium px-3" style="color: #212529;">
                                @(player.Points.HasValue ? player.Points.Value.ToString("N0") : "-")
                            </td>

                            <!-- Tournaments Played -->
                            <td class="text-center fw-medium px-3" style="color: #718078;">
                                @(player.TournamentsPlayed.HasValue ? player.TournamentsPlayed.Value.ToString() : "-")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>
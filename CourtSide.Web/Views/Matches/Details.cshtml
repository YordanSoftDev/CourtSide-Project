@model CourtSide.ViewModels.Matches.MatchDetailsViewModel

@{
    ViewData["Title"] = $"Match Details - {Model.FirstPlayerFullName} vs {Model.SecondPlayerFullName}";
}

@* CHANGE 1: Add the page container background style to match Index.cshtml *@
<div class="py-4" style="background-color: #EFF3EA; min-height: 100vh;">
    <div class="container">
        @* CHANGE 2: Replace 'shadow-sm' with 'shadow-lg rounded-4 overflow-hidden' for a softer, modern card look *@
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

            @* CHANGE 3: Replace 'bg-dark text-white' header with your custom soft primary green background (#EAF0E9) and dark text *@
            <div class="card-header p-4 d-flex justify-content-between align-items-center border-bottom" style="background-color: #EAF0E9 !important;">
                <h4 class="mb-0 fw-bold" style="color: #142D25 !important;"><i class="bi bi-info-circle"></i> Match Details</h4>

                @* CHANGE 4: Update date badge style to match forest green theme *@
                <span class="badge px-3 py-2 fs-6 rounded-pill" style="background-color: #142D25 !important; color: #ffffff;">
                    @Model.DateTime.ToString("f")
                </span>
            </div>

            <div class="card-body p-4 bg-white">
                <div class="row align-items-center text-center bg-light rounded-4 p-4 mb-4 border">
                    <div class="col-md-5">
                        <h3 class="mb-1 fw-bold" style="color: #142D25;">@Model.FirstPlayerFullName</h3>
                        @if (Model.WinnerFullName == Model.FirstPlayerFullName)
                        {
                            <span class="badge bg-success mt-1"><i class="bi bi-trophy-fill"></i> Winner</span>
                        }
                    </div>
                    <div class="col-md-2 my-3 my-md-0">
                        <span class="badge bg-danger fs-5 px-3 py-2 rounded-pill">VS</span>
                    </div>
                    <div class="col-md-5">
                        <h3 class="mb-1 fw-bold" style="color: #142D25;">@Model.SecondPlayerFullName</h3>
                        @if (Model.WinnerFullName == Model.SecondPlayerFullName)
                        {
                            <span class="badge bg-success mt-1"><i class="bi bi-trophy-fill"></i> Winner</span>
                        }
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 h-100 bg-white">
                            <h6 class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Tournament Info</h6>
                            <p class="fs-5 mb-0 fw-semibold" style="color: #142D25;">
                                <i class="bi bi-diagram-3 text-success me-2"></i>
                                @(Model.TournamentName ?? "Exhibition / Standalone Match")
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 h-100 bg-white">
                            <h6 class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Venue Location</h6>
                            @* DYNAMIC VENUE: Uses Model.VenueName (which will now display Palais des Sports de Gerland) *@
                            <p class="fs-5 mb-0 fw-semibold" style="color: #142D25;">
                                <i class="bi bi-geo-alt text-danger me-2"></i>
                                @(Model.VenueName ?? "Unassigned Court")
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            @* CHANGE 5: Clean up card footer and wrap Edit/Delete buttons in admin check *@
            <div class="card-footer bg-white p-3 border-top d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning fw-semibold">
                            <i class="bi bi-pencil-square"></i> Edit Match
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger fw-semibold">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
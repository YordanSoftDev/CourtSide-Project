@model IEnumerable<TennisScores.ViewModels.Tournaments.TournamentInfoViewModel>

@{
    ViewData["Title"] = "Tournaments";
}

<div class="container mt-4">
    <!-- Header & Create Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Tournaments</h2>
            <p class="text-muted mb-0">Overview of upcoming and ongoing tennis tournaments</p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Create Tournament
            </a>
        }
    </div>

    <!-- Tournaments Table -->
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            No tournaments found.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Tournament</th>
                        <th scope="col">Location</th>
                        <th scope="col">Dates</th>
                        <th scope="col">Type</th>
                        <th scope="col">Surface</th>
                        <th scope="col">Environment</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tournament in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">
                                <a asp-action="Details" asp-route-id="@tournament.Id" class="text-decoration-none">
                                    @tournament.TournamentName
                                </a>
                            </td>
                            <td>@tournament.Location</td>
                            <td>
                                <small class="text-muted">
                                    @tournament.StartDate.ToString("dd MMM yyyy") - @tournament.EndDate.ToString("dd MMM yyyy")
                                </small>
                            </td>
                            <td>
                                <span class="badge bg-info text-dark">@tournament.TournamentType</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@tournament.CourtSurface</span>
                            </td>
                            <td>
                                <span class="badge bg-outline-dark border">@tournament.CourtEnvironment</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@tournament.Id" class="btn btn-outline-info" title="Details">
                                        <i class="bi bi-eye"></i> Details
                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@tournament.Id" class="btn btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@tournament.Id" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
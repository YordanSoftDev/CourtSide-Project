@model TennisScores.ViewModels.Tournaments.TournamentDetailsViewModel

@{
    ViewData["Title"] = $"{Model.TournamentName} - Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <!-- Card Header -->
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">@Model.TournamentName</h3>
                    <span class="badge bg-info text-dark fs-6">@Model.TournamentType</span>
                </div>

                <!-- Card Body -->
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Location</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Location</dd>

                        <dt class="col-sm-4 text-muted">Start Date</dt>
                        <dd class="col-sm-8">@Model.StartDate.ToString("dd MMMM yyyy")</dd>

                        <dt class="col-sm-4 text-muted">End Date</dt>
                        <dd class="col-sm-8">@Model.EndDate.ToString("dd MMMM yyyy")</dd>

                        <dt class="col-sm-4 text-muted">Court Surface</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">@Model.CourtSurface</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Court Environment</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-outline-dark border">@Model.CourtEnvironment</span>
                        </dd>
                    </dl>
                </div>

                <!-- Card Footer / Actions -->
                <div class="card-footer bg-light d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@model IEnumerable<TennisScores.ViewModels.Players.PlayerInfoViewModel>

@{
    ViewData["Title"] = "Player";
}

<div class="container py-4" style="background-color: #ffffff;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #0d233a"><i class="bi bi-people-fill me-2"></i>Players</h2>
        <a asp-action="Create" asp-controller="Players"
           class="btn btn-primary btn-lg px-4 shadow-sm">Add New Player</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4 shadow-sm" role="alert">
            <h4 class="alert-heading">No Players Found!</h4>
            <p class="mb-0">There are currently no players in the database. Click the button above to add your first professional player.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-1">
            @foreach (var player in Model)
            {
                <div class="py-1 px-3 rounded-2 shadow-sm d-flex justify-content-between align-items-center"
                     style="background-color: #D4A017; border-bottom: 2px solid #0d233a;">

                    <!-- Player Name (Smaller Font & Icon) -->
                    <div class="d-flex align-items-center">
                        <span class="fw-bold mb-0"
                              style="color: #0d233a; font-size: 0.95rem; font-family: 'Segoe UI', system-ui, sans-serif;">
                            <i class="bi bi-person-badge me-1"></i>@player.FullName
                        </span>
                    </div>

                    <!-- Compact Action Buttons -->
                    <div class="d-flex gap-1">
                        <a asp-action="Details" asp-route-id="@player.Id"
                           class="btn btn-outline-dark btn-sm py-0 px-1 text-center"
                           style="width: 55px; background-color: #0d233a; border-color: #0d233a; color: #ffffff; font-size: 0.8rem;">
                            <i class="bi bi-eye"></i> Details
                        </a>
                        <a asp-action="Edit" asp-route-id="@player.Id"
                           class="btn btn-outline-dark btn-sm py-0 px-2"
                           style="background-color: #0d233a; border-color: #0d233a; color: #00e676; font-size: 0.8rem;">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@player.Id"
                           class="btn btn-dark btn-sm py-0 px-2"
                           style="background-color: #0d233a; border-color: #0d233a; color: #d41d08; font-size: 0.8rem;">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>